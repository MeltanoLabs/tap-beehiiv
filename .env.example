# beehiiv configuration
# Copy this file to .env and fill in your actual values

# Required: beehiiv API key (sent as a Bearer token)
TAP_BEEHIIV_API_KEY=your_api_key_here

# Optional: JSON array of publication IDs to sync (defaults to every publication the key can access)
# TAP_BEEHIIV_PUBLICATION_IDS='["pub_00000000-0000-0000-0000-000000000000"]'

# Optional: earliest date for ad_network_reports (send date) and engagements (RFC3339 format)
# TAP_BEEHIIV_START_DATE=2020-01-01T00:00:00Z

# Optional: objects to expand (JSON arrays, both default to ["stats"])
# TAP_BEEHIIV_POSTS_EXPAND='["stats"]'
# TAP_BEEHIIV_SUBSCRIPTIONS_EXPAND='["stats", "custom_fields"]'

# Optional: emit ACTIVATE_VERSION messages so targets remove records deleted in beehiiv (defaults to false)
# TAP_BEEHIIV_EMIT_ACTIVATE_VERSION_MESSAGES=true
